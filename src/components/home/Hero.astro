---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLang, useTranslations, localizePath } from "@/i18n/utils";
import { getSiteSettings } from "@/lib/sanity";
import HeroImpact from "./HeroImpact.astro";
import heroPhoto from "@/assets/images/hero-campaign-v2.webp";

const lang = getLang(Astro.url);
const hero = useTranslations(lang, "hero");
const { ninosAtendidos, comunidades } = await getSiteSettings();

---

<section id="inicio" data-hero class="hero relative isolate overflow-hidden bg-burgundy-950 text-white" aria-labelledby="hero-title">
  <div class="hero-visual absolute inset-0" aria-hidden="true">
    <Image src={heroPhoto} widths={[640, 960, 1440, 1920, 2560]} sizes="100vw" quality={85} alt="" loading="eager" fetchpriority="high" class="hero-photo h-full w-full object-cover" />
    <div class="hero-shade absolute inset-0"></div>
  </div>
  <div class="hero-layout relative mx-auto flex w-full max-w-[1480px] items-center px-6 sm:px-10 lg:px-12">
    <div class="hero-copy">
      <p class="hero-eyebrow mb-6 font-heading text-[0.65rem] font-bold uppercase tracking-[0.16em] text-white/80 sm:text-xs">{hero.heroEyebrow}</p>
      <h1 id="hero-title" class="hero-title font-heading font-bold">{hero.newTitleBefore}<br /><span>{hero.newTitleAccent}</span></h1>
      <p id="hero-description" class="hero-description mt-6 max-w-[29rem] text-base leading-relaxed text-white/85 sm:mt-7 sm:text-lg">{hero.newDescription}</p>
      <div class="hero-actions mt-8 flex flex-wrap items-center gap-x-7 gap-y-3 sm:mt-9">
        <a href={localizePath("/donate", lang)} aria-describedby="hero-description" class="hero-cta inline-flex min-h-[52px] items-center justify-center gap-4 rounded-full bg-primary px-7 py-3.5 font-heading text-base font-bold text-white transition-colors hover:bg-primary-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
          {hero.ctaPrimaryNew}<Icon name="arrow" class="h-3.5 w-auto" aria-hidden="true" />
        </a>
        <a href="#process" class="inline-flex min-h-12 items-center gap-2 font-heading text-sm font-medium text-white/90 underline-offset-8 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">{hero.ctaSecondaryNew}<Icon name="chevron-right" class="size-4" aria-hidden="true" /></a>
      </div>
    </div>
  </div>
  <svg class="hero-divider" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 0C240 72 1200 72 1440 0V60H0Z" fill="var(--color-cream)" /></svg>
</section>
<HeroImpact lang={lang} children={ninosAtendidos} communities={comunidades} />

<style>
  .hero-layout { min-height: clamp(660px, 88svh, 960px); padding-top: 112px; padding-bottom: 108px; }
  .hero-copy { width: min(48%, 620px); }
  .hero-title { font-size: clamp(3.5rem, 5.35vw, 5.75rem); line-height: 1.04; letter-spacing: -0.045em; }
  .hero-photo { object-position: 60% center; }
  .hero-shade { background: linear-gradient(90deg, rgb(14 0 11 / .62) 0%, rgb(14 0 11 / .38) 35%, rgb(14 0 11 / .06) 64%, transparent 100%); }
  .hero-divider { position: absolute; bottom: -1px; left: 0; width: 100%; height: 54px; pointer-events: none; }
  /* Reserve the remaining first-screen space for the impact strip.
     A content-driven minimum allows short viewports and text zoom to scroll. */
  @media (min-width: 1024px) {
    .hero-layout { min-height: clamp(480px, calc(100svh - 224px), 800px); padding-top: 104px; padding-bottom: 52px; }
    .hero-title { font-size: clamp(3rem, min(5.1vw, 8.5svh), 5.25rem); }
    .hero-eyebrow { margin-bottom: 18px; }
    .hero-description { margin-top: 20px; font-size: 1rem; }
    .hero-actions { margin-top: 24px; }
    .hero-photo { object-position: 60% 85%; }
    .hero-divider { height: 34px; }
  }
  @media (max-width: 767px) {
    .hero-layout { min-height: max(760px, 94svh); align-items: flex-end; padding-top: 360px; padding-bottom: 66px; }
    .hero-copy { width: 100%; max-width: 36rem; }
    .hero-photo { object-position: 80% top; }
    .hero-shade { background: linear-gradient(0deg, rgb(14 0 11 / .97) 0%, rgb(14 0 11 / .85) 25%, rgb(14 0 11 / .25) 60%, rgb(14 0 11 / .08) 100%); }
    .hero-eyebrow { max-width: 30ch; line-height: 1.7; margin-bottom: 16px; }
    .hero-title { font-size: clamp(2.75rem, 9.8vw, 4.5rem); }
    .hero-divider { height: 26px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy { animation: hero-enter 850ms cubic-bezier(.16, 1, .3, 1) both; }
    .hero-photo { animation: hero-settle 1500ms cubic-bezier(.16, 1, .3, 1) both; }
  }
  @keyframes hero-enter { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes hero-settle { from { transform: scale(1.025); } to { transform: scale(1); } }
</style>
