---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLang, useTranslations, localizePath } from "@/i18n/utils";
import { getHeroSlides, getSiteSettings } from "@/lib/sanity";
import secondaryPhoto from "@/assets/images/gallery/8.webp";

const lang = getLang(Astro.url);
const hero = useTranslations(lang, "hero");

// Contenido editable por el equipo en Sanity (leído en build; fallback = código).
// El schema de Sanity soporta varios slides; el hero editorial usa solo el primero
// como foto + copy principal (los demás quedan disponibles para uso futuro).
const slides = await getHeroSlides(lang);
const slide = slides[0];
const { ninosAtendidos } = await getSiteSettings();

const STAT_CHILDREN = `${ninosAtendidos.toLocaleString("en-US")}+`;
---

<section id="inicio" data-hero class="hero-editorial relative bg-white pt-24 sm:pt-28">
  <div class="mx-auto grid w-full max-w-[1400px] lg:grid-cols-2 lg:items-stretch">
    <!-- Fotografía documental (izquierda), real, blanco y negro editorial -->
    <div class="relative order-1 h-[58vh] min-h-[380px] sm:h-[68vh] lg:h-auto lg:min-h-[85vh]">
      <div class="hero-photo-frame absolute inset-0 overflow-hidden bg-ink-900">
        <!-- `slide.img` ya viene con URL resuelta (Sanity o local): <img> plano, sin astro:assets -->
        <img
          src={slide.img.src}
          srcset={slide.img.srcset}
          sizes="(min-width: 1024px) 50vw, 100vw"
          width={slide.img.width}
          height={slide.img.height}
          alt={slide.alt}
          loading="eager"
          fetchpriority="high"
          class="hero-photo h-full w-full object-cover"
        />
      </div>

      <!-- Ficha documental -->
      <span
        data-reveal
        class="absolute left-5 top-5 inline-flex items-center gap-2 bg-white/90 px-3 py-1.5 font-heading text-[0.65rem] font-bold uppercase tracking-[0.14em] text-ink-900 sm:left-8 sm:top-8"
      >
        {hero.photoCaption}
      </span>

      <!-- Foto secundaria superpuesta (archivo fotográfico, tambien real) -->
      <div
        data-reveal
        style="--reveal-delay: 200ms"
        class="hero-secondary-photo absolute bottom-4 right-5 w-[46%] max-w-[260px] border-[6px] border-white bg-white shadow-[0_18px_36px_-16px_rgb(0_0_0/0.45)] sm:right-8 lg:-bottom-10 lg:right-10"
      >
        <Image
          src={secondaryPhoto}
          alt={hero.secondaryImageAlt}
          widths={[260, 400, 520]}
          sizes="260px"
          quality={80}
          loading="eager"
          class="hero-photo aspect-[4/5] w-full object-cover"
        />
      </div>
    </div>

    <!-- Contenido editorial (derecha) -->
    <div
      class="relative order-2 flex flex-col justify-center px-6 pb-20 pt-16 sm:px-10 sm:pt-20 lg:px-16 lg:pb-16 lg:pt-16 xl:px-20"
    >
      <!-- Linea que se dibuja de fondo: hilo andino, no una foto ni un icono generico -->
      <svg
        class="hero-line pointer-events-none absolute inset-0 h-full w-full"
        preserveAspectRatio="none"
        viewBox="0 0 100 100"
        aria-hidden="true"
      >
        <path
          d="M 80 2 C 55 18, 98 40, 66 58 S 58 92, 22 98"
          fill="none"
          stroke="var(--color-primary)"
          stroke-width="1.4"
          vector-effect="non-scaling-stroke"
        />
      </svg>

      <span
        data-reveal
        class="inline-flex w-fit items-center gap-2.5 font-heading text-xs font-bold uppercase tracking-[0.16em] text-primary"
      >
        <span class="size-2 shrink-0 bg-primary" aria-hidden="true"></span>
        {hero.eyebrow}
      </span>

      <h1
        data-reveal
        style="--reveal-delay: 80ms"
        class="mt-6 font-heading text-[2.6rem] font-bold leading-[1.08] text-ink-950 sm:text-6xl lg:text-[3.6rem] xl:text-[4rem]"
        set:html={slide.titulo}
      />

      <p
        data-reveal
        style="--reveal-delay: 160ms"
        class="mt-6 max-w-lg font-body text-base leading-relaxed text-ink-600 sm:text-lg"
        set:html={slide.texto}
      />

      <p
        data-reveal
        style="--reveal-delay: 220ms"
        class="mt-5 max-w-lg border-l-2 border-ink-200 pl-4 font-body text-sm italic leading-relaxed text-ink-500"
      >
        {hero.missionNote}
      </p>

      <div data-reveal style="--reveal-delay: 280ms" class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href={localizePath("/donate", lang)}
          class="hero-cta inline-flex items-center justify-center bg-primary px-9 py-4 font-heading text-sm font-bold text-white transition-[background-color,transform] duration-200 ease-out hover:bg-primary-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {hero.ctaPrimary}
        </a>
        <a
          href="#proposito"
          class="group inline-flex items-center gap-2 font-heading text-sm font-bold text-primary transition-colors duration-200 hover:text-primary-600"
        >
          {hero.ctaSecondary}
          <Icon name="arrow" class="h-3.5 w-auto transition-transform duration-200 ease-out group-hover:translate-x-1" />
        </a>
      </div>

      <p
        data-reveal
        style="--reveal-delay: 340ms"
        class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-1.5 font-heading text-xs font-semibold uppercase tracking-[0.06em] text-ink-400"
      >
        <span class="inline-flex items-center gap-1.5">
          <span class="size-1.5 bg-primary" aria-hidden="true"></span>
          {hero.locationLine}
        </span>
        <span class="h-3 w-px bg-ink-200" aria-hidden="true"></span>
        <span class="tabular-nums text-ink-600">{STAT_CHILDREN}</span>
        {hero.statChildrenLabel}
      </p>
    </div>
  </div>
</section>

<style>
  .hero-photo {
    filter: grayscale(1) contrast(1.08);
  }

  /* Foto secundaria: pequeña rotación al entrar, foto colocada "a mano" */
  .hero-secondary-photo {
    transform: rotate(-2deg);
  }

  /* Linea de fondo: se dibuja una vez al cargar (hilo andino), no un icono generico */
  .hero-line path {
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
    opacity: 0.3;
    animation: hero-line-draw 1800ms cubic-bezier(0.23, 1, 0.32, 1) 200ms forwards;
  }
  @keyframes hero-line-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Feedback de presión en el CTA principal */
  .hero-cta:active {
    transform: scale(0.97);
  }

  /* Acento del titulo: solo color, sin glow/gradiente (direccion editorial) */
  h1 :global(.text-primary) {
    color: var(--color-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
