---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLang, useTranslations, localizePath } from "@/i18n/utils";
import { getSiteSettings } from "@/lib/sanity";
import HeroImpact from "./HeroImpact.astro";
import heroPhoto from "@/assets/images/hero-campaign-v2.webp";

const lang = getLang(Astro.url);
const hero = useTranslations(lang, "hero");
const { ninosAtendidos, comunidades } = await getSiteSettings();

// Friaje en la puna. Mismo dato que el parrafo de Purpose ("supera los −20 °C").
const COLD = 20;

---

<section id="inicio" data-hero class="hero relative isolate overflow-hidden bg-burgundy-950 text-white" aria-labelledby="hero-title">
  <div class="hero-visual absolute inset-0" aria-hidden="true">
    <Image src={heroPhoto} widths={[640, 960, 1440, 1920, 2560]} sizes="100vw" quality={85} alt="" loading="eager" fetchpriority="high" class="hero-photo h-full w-full object-cover" />
    <div class="hero-shade absolute inset-0"></div>
  </div>
  <div class="hero-layout relative mx-auto flex w-full max-w-[1480px] items-center px-6 sm:px-10 lg:px-12">
    <div class="hero-copy">
      <p class="hero-eyebrow mb-6 inline-flex items-center gap-3 font-heading text-[0.65rem] font-bold uppercase tracking-[0.16em] text-white/80 sm:text-xs"><span class="hero-eyebrow-line h-0.5 w-8 bg-primary" aria-hidden="true"></span><span class="hero-eyebrow-text">{hero.heroEyebrow}</span></p>
      <h1 id="hero-title" class="hero-title font-heading font-bold"><span class="hero-line"><span class="hero-line-inner">{hero.newTitleBefore.trim()}</span></span><span class="hero-line"><span class="hero-line-inner">{hero.newTitleAccent}</span></span></h1>
      <p id="hero-description" class="hero-description mt-6 max-w-[29rem] text-base leading-relaxed text-white/85 sm:mt-7 sm:text-lg">{hero.newDescription}</p>
      <div class="hero-actions mt-8 flex flex-wrap items-center gap-x-7 gap-y-3 sm:mt-9">
        <a href={localizePath("/donate", lang)} aria-describedby="hero-description" class="hero-cta inline-flex min-h-[52px] items-center justify-center gap-4 rounded-full bg-primary px-7 py-3.5 font-heading text-base font-bold text-white transition-colors hover:bg-primary-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
          {hero.ctaPrimaryNew}<Icon name="arrow" class="h-3.5 w-auto" aria-hidden="true" />
        </a>
        <a href="#process" class="inline-flex min-h-12 items-center gap-2 font-heading text-sm font-medium text-white/90 underline-offset-8 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">{hero.ctaSecondaryNew}<Icon name="chevron-right" class="size-4" aria-hidden="true" /></a>
      </div>
    </div>
  </div>
  <p class="hero-temp" data-hero-temp data-cold={COLD} aria-label={`−${COLD} °C · ${hero.tempLabel}`}>
    <span class="hero-therm" aria-hidden="true"><span class="hero-therm-fill"></span></span>
    <span class="hero-temp-text" aria-hidden="true">
      <span class="hero-temp-value" data-hero-temp-value>−{COLD} °C</span>
      <span class="hero-temp-label">{hero.tempLabel}</span>
    </span>
  </p>
  <svg class="hero-divider" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 0C240 72 1200 72 1440 0V60H0Z" fill="var(--color-cream)" /></svg>
</section>
<HeroImpact lang={lang} children={ninosAtendidos} communities={comunidades} />

<style>
  .hero-layout { min-height: clamp(660px, 88svh, 960px); padding-top: 112px; padding-bottom: 108px; }
  .hero-copy { width: min(48%, 620px); }
  .hero-title { font-size: clamp(3.5rem, 5.35vw, 5.75rem); line-height: 1.04; letter-spacing: -0.045em; }
  .hero-photo { object-position: 60% center; }
  .hero-shade { background: linear-gradient(90deg, rgb(14 0 11 / .62) 0%, rgb(14 0 11 / .38) 35%, rgb(14 0 11 / .06) 64%, transparent 100%); }
  .hero-divider { position: absolute; bottom: -1px; left: 0; width: 100%; height: 54px; pointer-events: none; }
  /* Reserve the remaining first-screen space for the impact strip.
     A content-driven minimum allows short viewports and text zoom to scroll. */
  @media (min-width: 1024px) {
    .hero-layout { min-height: clamp(480px, calc(100svh - 224px), 800px); padding-top: 104px; padding-bottom: 52px; }
    .hero-title { font-size: clamp(3rem, min(5.1vw, 8.5svh), 5.25rem); }
    .hero-eyebrow { margin-bottom: 18px; }
    .hero-description { margin-top: 20px; font-size: 1rem; }
    .hero-actions { margin-top: 24px; }
    .hero-photo { object-position: 60% 85%; }
    .hero-divider { height: 34px; }
  }
  @media (max-width: 767px) {
    /* Todo el copy + CTA entra en el primer viewport (svh = con las barras de Safari visibles).
       El contenido manda la altura minima; la foto ocupa el aire de arriba. */
    /* Altura dictada por el contenido: sin cielo vacio arriba. Asi la seccion de impacto
       asoma en el primer viewport y se entiende que hay mas abajo. */
    .hero-layout { min-height: 0; align-items: flex-end; padding-top: 6.25rem; padding-bottom: 3rem; }
    .hero-copy { width: 100%; max-width: 36rem; }
    /* Anclada abajo + zoom: los ninos (parte baja de la foto) quedan detras del copy. */
    .hero-photo { object-position: 72% 100%; scale: 1.3; transform-origin: 72% 100%; }
    /* Scrim superior: da contraste al termometro y al navbar sobre las nubes claras. */
    .hero-shade { background:
      linear-gradient(180deg, rgb(14 0 11 / .45) 0%, transparent 24%),
      linear-gradient(0deg, rgb(14 0 11 / .96) 0%, rgb(14 0 11 / .82) 34%, rgb(14 0 11 / .25) 64%, rgb(14 0 11 / .05) 100%); }
    .hero-eyebrow { max-width: none; margin-bottom: 14px; font-size: .625rem; letter-spacing: .14em; }
    .hero-title { font-size: clamp(2.6rem, 11.5vw, 4.5rem); }
    .hero-description { margin-top: 16px; font-size: 1rem; line-height: 1.55; }
    .hero-actions { margin-top: 24px; flex-direction: column; align-items: stretch; gap: 4px; }
    .hero-cta { width: 100%; min-height: 56px; box-shadow: 0 10px 28px -10px rgb(228 0 63 / .7); }
    .hero-actions a:not(.hero-cta) { justify-content: center; }
    .hero-divider { height: 26px; }
  }
  .hero-line { display: block; overflow: hidden; padding: 0.06em 0.02em 0.14em; margin: -0.06em -0.02em -0.14em; }
  .hero-line-inner { display: block; }
  .hero-actions a svg { transition: transform 220ms cubic-bezier(.2, 0, 0, 1); }
  .hero-cta { transition: background-color 200ms, transform 150ms cubic-bezier(.2, 0, 0, 1); }
  .hero-cta:active { transform: scale(.97); }
  /* Termometro editorial sobre la foto: sin caja, la escala (+10 a -20 °C) se llena con el frio.
     --cold (0 -> 1) lo mueve el script: baja el mercurio y tine el numero de azul hielo. */
  .hero-temp { --cold: 1; position: absolute; z-index: 2; right: 3rem; bottom: 5.5rem; display: flex; align-items: stretch; gap: .9rem; font-family: var(--font-heading); text-shadow: 0 2px 16px rgb(14 0 11 / .65); }
  .hero-temp::before { content: ""; position: absolute; inset: -2.5rem -3rem -2rem -2.5rem; z-index: -1; background: radial-gradient(closest-side, rgb(14 0 11 / .5), transparent); pointer-events: none; }
  .hero-therm { position: relative; width: 4px; height: 4.5rem; border-radius: 4px; background: rgb(255 255 255 / .28); background-image: repeating-linear-gradient(to bottom, transparent 0 calc(33.333% - 1px), rgb(14 0 11 / .55) calc(33.333% - 1px) 33.333%); overflow: hidden; }
  .hero-therm-fill { position: absolute; inset: 0; background: #a9d6f5; transform-origin: top; transform: scaleY(calc(.333 + var(--cold) * .667)); }
  .hero-temp-text { display: flex; flex-direction: column; justify-content: center; gap: .15rem; }
  .hero-temp-value { font-size: clamp(2rem, 2.6vw, 2.5rem); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -.045em; color: color-mix(in oklab, #fff calc((1 - var(--cold)) * 100%), #a9d6f5); }
  .hero-temp-label { font-size: .6875rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: rgb(255 255 255 / .85); }
  /* En mobile el termometro compite con la foto y el navbar: se oculta (el dato sigue en Purpose). */
  @media (max-width: 767px) { .hero-temp { display: none; } }
  @media (prefers-reduced-motion: no-preference) {
    /* Coreografia: eyebrow -> titulo (linea a linea) -> descripcion -> CTAs -> chip. Ola corta (~1.3s). */
    .hero-eyebrow-line { transform-origin: left; animation: hero-line-grow 700ms cubic-bezier(.16, 1, .3, 1) 150ms both; }
    .hero-eyebrow-text { animation: hero-rise 700ms cubic-bezier(.16, 1, .3, 1) 250ms both; }
    .hero-line-inner { animation: hero-mask-up 1000ms cubic-bezier(.16, 1, .3, 1) calc(350ms + var(--l, 0) * 110ms) both; }
    .hero-line:nth-child(2) .hero-line-inner { --l: 1; }
    .hero-description { animation: hero-rise 800ms cubic-bezier(.16, 1, .3, 1) 750ms both; }
    .hero-actions { animation: hero-rise 800ms cubic-bezier(.16, 1, .3, 1) 900ms both; }
    .hero-temp { animation: hero-chip-in 700ms cubic-bezier(.16, 1, .3, 1) 1100ms both; }
    .hero-photo { animation: hero-settle 1600ms cubic-bezier(.16, 1, .3, 1) both; }
    .hero-cta:hover svg, .hero-actions a:hover svg { transform: translateX(4px); }
    /* Parallax de la foto al scrollear (solo navegadores con scroll-driven animations). */
    @supports (animation-timeline: scroll()) {
      .hero-visual { top: -8%; animation: hero-parallax linear both; animation-timeline: scroll(root); animation-range: 0 100svh; }
    }
  }
  @keyframes hero-line-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes hero-mask-up { from { transform: translateY(115%); } to { transform: none; } }
  @keyframes hero-chip-in { from { opacity: 0; transform: translateY(10px) scale(.96); } to { opacity: 1; transform: none; } }
  @keyframes hero-settle { from { transform: scale(1.04); } to { transform: scale(1); } }
  @keyframes hero-parallax { from { transform: translateY(0); } to { transform: translateY(7%); } }
</style>

<script>
  // El frio "se instala": el numero baja de 0 a -20 °C justo cuando entra el chip.
  function initHeroTemp() {
    const el = document.querySelector<HTMLElement>("[data-hero-temp]:not([data-bound])");
    const out = el?.querySelector<HTMLElement>("[data-hero-temp-value]");
    if (!el || !out) return;
    el.setAttribute("data-bound", "");
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const target = Number(el.dataset.cold) || 0;
    const DELAY = 1250;
    const DUR = 1500;
    const render = (p: number) => {
      out.textContent = `−${Math.round(target * p)} °C`;
      el.style.setProperty("--cold", p.toFixed(3));
    };
    render(0);
    setTimeout(() => {
      const t0 = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - t0) / DUR);
        render(p === 1 ? 1 : 1 - Math.pow(2, -10 * p)); // easeOutExpo
        if (p < 1) requestAnimationFrame(tick);
        else render(1);
      };
      requestAnimationFrame(tick);
    }, DELAY);
  }
  document.addEventListener("astro:page-load", initHeroTemp);
</script>
