---
import { Icon } from "astro-icon/components";
import { getLang, useTranslations, localizePath } from "@/i18n/utils";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const lang = getLang(Astro.url);
const t = useTranslations(lang, "purpose");
const tGallery = useTranslations(lang, "gallery");

const chips = [
  { icon: "purpose-volunteer", label: t.chipHonorem },
  { icon: "purpose-community-heart", label: t.chipNonprofit },
  { icon: "purpose-thermal-jacket", label: t.chipJackets },
];

// "−20 °C" del parrafo se resalta (azul glaciar + subrayado animado). Se busca en el
// texto traducido, asi el dato sigue viviendo en i18n y no se duplica aqui.
const [beforeCold, coldText, afterCold] = t.paragraph1.split(/(−\d+\s?°C)/);

// Carrusel de la seccion: mismas fotos que la galeria. Ritmo editorial alto/ancho con
// desniveles. La lista se duplica (clones) para el bucle infinito; los clones solo se
// muestran con la animacion activa (sin JS / reduced-motion = swipe nativo).
const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/gallery/*.webp",
  { eager: true },
);
const photos = Object.entries(galleryModules)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, mod]) => mod.default);
const FRAMES = ["tall", "wide", "wide", "tall", "wide"] as const;
const slides = [
  ...photos.map((src, i) => ({ src, i, clone: false })),
  ...photos.map((src, i) => ({ src, i, clone: true })),
];
---

<section id="proposito" data-purpose class="purpose relative z-10 overflow-hidden bg-cream pb-24 pt-8 sm:pt-10 lg:pt-10">
  <div class="relative mx-auto grid w-full max-w-[1280px] items-center gap-12 px-6 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
    <!-- Columna texto -->
    <div data-purpose-text>
      <div class="flex items-center gap-4">
        <span class="h-0.5 w-8 origin-left bg-primary" data-purpose-eyebrow-line></span>
        <span class="font-heading text-sm font-bold uppercase tracking-[0.7px] text-primary" data-purpose-eyebrow>
          {t.eyebrow}
        </span>
      </div>
      <h2 class="mt-6 font-heading text-3xl font-bold uppercase leading-tight text-burgundy sm:text-4xl lg:text-[40px] lg:leading-[1.2]" data-purpose-title>
        {t.title}
      </h2>
      <p class="mt-6 font-body leading-relaxed text-ink sm:text-lg" data-purpose-para>
        {beforeCold}{
          coldText && (
            <span class="relative inline-block whitespace-nowrap font-medium text-[#3f6383]">
              {coldText}
              <span class="absolute inset-x-0 -bottom-0.5 h-[2px] origin-left rounded-full bg-[#3f6383]/60" aria-hidden="true" data-purpose-cold-line></span>
            </span>
          )
        }{afterCold}
      </p>
      <p class="mt-5 font-body leading-relaxed text-ink sm:text-lg" data-purpose-para>{t.paragraph2}</p>
      <ul class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:flex-nowrap">
        {
          chips.map((chip) => (
            <li class="inline-flex w-full shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-full bg-burgundy px-4 py-2 font-body text-sm font-medium text-white sm:w-auto sm:justify-start" data-purpose-chip>
              <Icon name={chip.icon} class="size-6 shrink-0" aria-hidden="true" />
              {chip.label}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Tarjeta infografia: flota en parallax (wrapper) + inclinacion 3D (card) -->
    <div data-purpose-card-float>
      <div class="purpose-card relative flex flex-col items-start gap-4 overflow-hidden rounded-3xl bg-[linear-gradient(145deg,var(--color-primary)_0%,var(--color-primary-600)_100%)] p-8 text-white shadow-[0px_30px_60px_-20px_rgb(176_0_47/0.55)] sm:p-10" data-purpose-card>
        <!-- Brillo que sigue al cursor (solo puntero fino) -->
        <span class="purpose-card-glare pointer-events-none absolute inset-0" aria-hidden="true"></span>
        <span data-purpose-card-item data-purpose-heart class="inline-flex">
          <Icon name="purpose-heart" class="h-9 w-auto" />
        </span>
        <h3 class="mt-2 font-heading text-2xl font-bold sm:text-[1.75rem]" data-purpose-card-item>{t.cardTitle}</h3>
        <p class="font-body leading-relaxed text-white/90" data-purpose-card-item>{t.cardText}</p>
        <a
          href={localizePath("/infographic", lang)}
          class="group relative mt-2 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 font-heading text-sm font-bold uppercase tracking-wide text-primary shadow-[0_10px_24px_-12px_rgb(14_0_11/0.5)] transition-[transform,box-shadow] duration-200 ease-out hover:-translate-y-0.5 hover:shadow-[0_14px_30px_-12px_rgb(14_0_11/0.6)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white active:translate-y-0 active:scale-[0.98]"
          data-purpose-card-item
        >
          {t.cardCta}
          <Icon name="purpose-download" class="h-4 w-auto transition-transform duration-300 ease-out group-hover:translate-y-0.5" />
        </a>
      </div>
    </div>
  </div>

  <!-- Carrusel: avanza solo, acelera con el scroll, se arrastra con inercia y enfoca la foto
       bajo el cursor. Sin JS (o reduced-motion) es un swipe nativo con snap. -->
  <div class="purpose-strip relative mt-16 sm:mt-20" data-purpose-strip>
    <ul class="purpose-track flex w-max items-start px-3 sm:px-[5vw]" data-purpose-track>
      {
        slides.map(({ src, i, clone }) => (
          <li
            class:list={[
              "purpose-photo shrink-0",
              FRAMES[i % FRAMES.length] === "tall" ? "purpose-photo--tall" : "purpose-photo--wide",
              i % 2 === 1 && "purpose-photo--low",
              clone && "purpose-photo--clone",
            ]}
            aria-hidden={clone ? "true" : undefined}
            data-purpose-photo
          >
            <div class="purpose-photo-frame relative h-full w-full overflow-hidden rounded-[1.25rem] bg-mist">
              <Image
                src={src}
                alt={clone ? "" : tGallery.imageAlt}
                loading="lazy"
                draggable="false"
                widths={[360, 540, 720]}
                sizes="(min-width: 640px) 440px, 300px"
                quality={72}
                class="purpose-photo-img absolute inset-y-0 -left-[8%] h-full w-[116%] max-w-none object-cover"
                data-purpose-photo-img
              />
            </div>
          </li>
        ))
      }
    </ul>


  </div>
</section>

<script>
  import { initPurposeMotion, destroyPurposeMotion } from "@/scripts/purpose-motion";

  document.addEventListener("astro:page-load", initPurposeMotion);
  document.addEventListener("astro:before-swap", destroyPurposeMotion);
</script>

<style>
  /* Base (sin JS / reduced-motion): swipe nativo con snap, sin clones. */
  .purpose-strip {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .purpose-strip::-webkit-scrollbar {
    display: none;
  }
  .purpose-photo {
    width: 14rem;
    height: 11rem;
    margin-inline: 0.5rem;
    scroll-snap-align: start;
  }
  .purpose-photo--tall {
    width: 11rem;
    height: 14rem;
  }
  .purpose-photo--low {
    margin-top: 2.5rem;
  }
  .purpose-photo--clone {
    display: none;
  }
  .purpose-photo-frame {
    box-shadow: 0 18px 40px -22px rgb(14 0 11 / 0.45);
    transition:
      transform 500ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .purpose-photo-img {
    transition: filter 500ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  @media (min-width: 640px) {
    .purpose-photo {
      width: 27rem;
      height: 19rem;
      margin-inline: 0.75rem;
    }
    .purpose-photo--tall {
      width: 18rem;
      height: 23rem;
    }
    .purpose-photo--low {
      margin-top: 4.5rem;
    }
  }

  /* Con la animacion activa: la mueve GSAP (bucle con clones), el dedo arrastra. */
  .purpose-strip[data-motion="on"] {
    overflow: hidden;
    scroll-snap-type: none;
    touch-action: pan-y;
    user-select: none;
  }
  .purpose-strip[data-motion="on"] .purpose-photo--clone {
    display: list-item;
  }
  .purpose-strip[data-motion="on"] .purpose-track {
    will-change: transform;
  }

  /* Foco: la foto bajo el cursor sube y queda a color; el resto se apaga un poco. */
  @media (hover: hover) and (pointer: fine) {
    .purpose-strip[data-motion="on"]:hover .purpose-photo-img {
      filter: grayscale(0.85) brightness(0.9);
    }
    .purpose-strip[data-motion="on"] .purpose-photo:hover .purpose-photo-img {
      filter: none;
    }
    .purpose-strip[data-motion="on"] .purpose-photo:hover .purpose-photo-frame {
      transform: translateY(-10px) scale(1.03);
      box-shadow: 0 30px 50px -24px rgb(14 0 11 / 0.6);
    }
    .purpose-strip[data-dragging="on"] .purpose-photo-frame {
      transform: none !important;
    }
  }

  .purpose-card {
    transform-style: preserve-3d;
    will-change: transform;
  }
  .purpose-card-glare {
    background: radial-gradient(
      circle at var(--gx, 50%) var(--gy, 0%),
      rgb(255 255 255 / 0.28),
      transparent 55%
    );
    opacity: 0;
    transition: opacity 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  @media (hover: hover) {
    .purpose-card:hover .purpose-card-glare {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .purpose-card-glare {
      display: none;
    }
  }
</style>
